{
  "name": "@0xaicrypto/crypto-strategy-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for Crypto Strategy - AI Macro Cycle & Dynamic DCA Engine with Fluxion 0-Gas Execution",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "crypto-strategy-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "build:esbuild": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --banner:js=\"#!/usr/bin/env node\" --outfile=dist/index.js",
    "dev": "tsup --watch",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "crypto",
    "defi",
    "mantle",
    "fluxion",
    "trading",
    "ai-agent",
    "cursor",
    "claude"
  ],
  "author": "0xaicrypto",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "esbuild": "^0.28.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  }
}
