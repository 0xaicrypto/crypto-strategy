{
  "name": "crypto-strategy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI-driven Crypto Dynamic Value DCA and Macro Cycle Position Management System",
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
    "analyze": "node --experimental-strip-types src/index.ts analyze",
    "scan": "node --experimental-strip-types src/index.ts scan",
    "backtest": "node --experimental-strip-types src/index.ts backtest",
    "web": "node --experimental-strip-types src/server.ts",
    "dev": "node --experimental-strip-types src/server.ts",
    "mcp": "node mcp/dist/index.js",
    "mcp:build": "cd mcp && npm run build",
    "build:pages": "node --experimental-strip-types src/build-static.ts",
    "build:privy": "esbuild src/privy-auth-entry.tsx --bundle --minify --format=iife --target=es2020 --define:process.env.NODE_ENV=\\\"production\\\" --define:global=\\\"window\\\" --external:@stripe/stripe-js --outfile=public/js/privy-bundle.js",
    "strk": "node --experimental-strip-types src/index.ts evaluate --asset STRK",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@privy-io/react-auth": "^3.47.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.57.3"
  }
}
